# Enables Analyze, Ask and battlecard generation. Without it everything else
# still works and the UI shows an "AI off" badge.
ANTHROPIC_API_KEY=

# Model used for analysis and answers.
CIQ_MODEL=claude-opus-5

# Permanent storage. Set this to a managed Postgres connection string and the
# library survives deploys, restarts and instance moves. Neon, Supabase and
# Render Postgres all work. When unset the app falls back to local SQLite.
DATABASE_URL=

# SQLite fallback path, used only when DATABASE_URL is empty.
CIQ_DB_PATH=./data/library.db

# Admin passcode, verified on the server. Change this before going live.
CIQ_ADMIN_PASSCODE=impact

# Signs admin session cookies. Set it so sessions survive restarts and are
# valid across every worker.
CIQ_SECRET_KEY=

# Upload and remote fetch limits.
CIQ_MAX_UPLOAD_BYTES=26214400
CIQ_ALLOW_REMOTE_FETCH=true
