# Enables Analyze, Ask and battlecard generation. Without it everything else
# still works and the UI shows an "AI off" badge.
ANTHROPIC_API_KEY=

# Model used for analysis and answers.
CIQ_MODEL=claude-opus-5

# Permanent storage, option A: a full connection string.
# Surrounding quotes and whitespace are stripped automatically.
DATABASE_URL=

# Permanent storage, option B: the same credentials as separate parts. Used
# only when DATABASE_URL is empty. Prefer this when the password contains
# characters such as @ / # ? or &, because supplied separately it needs no
# percent-encoding and cannot truncate a URL.
CIQ_DB_HOST=
CIQ_DB_USER=
CIQ_DB_PASSWORD=
CIQ_DB_NAME=postgres
CIQ_DB_PORT=5432

# SQLite fallback path, used only when DATABASE_URL is empty.
CIQ_DB_PATH=./data/library.db

# Google sign-in. Access is limited to accounts in this domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CIQ_ALLOWED_EMAIL_DOMAIN=impactanalytics.co

# With sign-in unconfigured the app stays usable and shows an "Open access"
# badge. Set this to refuse every request until sign-in is configured.
CIQ_REQUIRE_AUTH=false

# Signs admin session cookies. Set it so sessions survive restarts and are
# valid across every worker.
CIQ_SECRET_KEY=

# Upload and remote fetch limits.
CIQ_MAX_UPLOAD_BYTES=26214400
CIQ_ALLOW_REMOTE_FETCH=true
