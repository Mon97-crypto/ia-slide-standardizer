# Copy to .env for local dev. Server-side only — these are read inside the
# route handlers under src/routes/api/public and are NEVER bundled into the
# browser. Each signal tier degrades gracefully when its key is absent.

# ── Search source (news, leadership, pain, migration, expansion, budget,
#    closures, RFP, layoffs). Pick ONE backend. ──────────────────────────────
# SerpAPI (simplest — also powers the jobs feed below):
SERPAPI_KEY=
# Optional: override the SerpAPI host (self-hosted proxy, or local testing):
# SERPAPI_BASE_URL=https://serpapi.com
# ...or Google Programmable Search (Custom Search Engine):
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ── Jobs feed (hiring_activity, no_job_openings). ──────────────────────────
# Reuses SERPAPI_KEY (Google Jobs engine) if set. Otherwise Adzuna:
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Optional funding source (private-company M&A / IPO). Off by default; it
#    consumes search quota. Needs a search key above. ────────────────────────
SCAN_FUNDING=off

# ── Contacts (apollo-contacts). ────────────────────────────────────────────
APOLLO_API_KEY=

# ── Optional single-source fallback: if no search key is set but this is,
#    the news tier uses one Anthropic web-search call instead. ───────────────
ANTHROPIC_API_KEY=

# Optional overrides.
# SCAN_NEWS_MODEL=claude-sonnet-4-6
# SEC_USER_AGENT=ImpactAnalytics-AccountScanner research@impactanalytics.ai
# PORT=8787
