# Copy to .env for local dev. Server-side only — these are read inside
# supabase/functions-equivalent handlers under src/routes/api/public and are
# NEVER bundled into the browser.

# Enables the scan-news AI function (Anthropic web-search research).
ANTHROPIC_API_KEY=

# Enables apollo-contacts (retargeted CXO lookup).
APOLLO_API_KEY=

# Optional overrides.
# SCAN_NEWS_MODEL=claude-sonnet-4-6
# SEC_USER_AGENT=ImpactAnalytics-AccountScanner research@impactanalytics.ai
# PORT=8787
